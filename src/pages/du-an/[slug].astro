      pageSpeed: "99/100",
      badge: "🏢 DỰ ÁN BẤT ĐỘNG SẢN CAO CẤP",
      headline: "Căn Hộ Hạng Sang Trung Tâm Thành Phố",
      gradient: "from-ocean-600 via-sky-500 to-aqua-500",
      detail: "Sở hữu căn hộ tầm nhìn sông Panorama 360 độ. Ưu đãi chiết khấu 8% + Tặng gói nội thất 150 triệu.",
      stats: [
        { value: "8.5%", label: "Tỷ Lệ Chuyển Đổi Ads" },
        { value: "350+", label: "Khách Đăng Ký Tham Quan" },
        { value: "99/100", label: "Google PageSpeed" },
      ],
      features: [
        { title: "Mặt bằng căn hộ 3D tương tác", desc: "Xem chi tiết thiết kế từng phòng và góc nhìn panorama 360 độ." },
        { title: "Bảng giá & Tiến độ thanh toán 2026", desc: "Cập nhật bảng giá niêm yết từ chủ đầu tư và chính sách ngân hàng 0%." },
        { title: "Vị trí kim cương kết nối Metro", desc: "Liền kề ga tuyến Metro số 1, di chuyển trung tâm chỉ 10 phút." },
