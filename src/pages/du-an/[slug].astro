    {
      slug: "autoviet-motors",
      name: "AutoViet Motors",
      desc: "Landing Page Showroom Xe Điện & Ô Tô Thông Minh",
      category: "Ô Tô / Xe Điện",
      pageSpeed: "98/100",
      badge: "🚗 SHOWROOM XE ĐIỆN THÔNG MINH 2026",
      headline: "Trải Nghiệm Tương Lai Di Chuyển Xanh",
      gradient: "from-blue-600 via-ocean-500 to-emerald-500",
      detail: "Dòng xe điện thông minh quãng đường 550km / lần sạc. Tự hành Level 3 và hệ thống an toàn 5 sao ASEAN NCAP.",
      stats: [
        { value: "450+", label: "Đăng Ký Lái Thử Tận Nhà" },
        { value: "0%", label: "Lãi Suất Trả Góp 12 Tháng" },
        { value: "10 Năm", label: "Bảo Hành Pin Xe Điện" },
      ],
      features: [
        { title: "Đăng ký lái thử tận nhà miễn phí", desc: "Xe được chở tới tận nhà bạn để lái thử trải nghiệm thực tế." },
        { title: "Bảng màu xe 3D xoay 360 độ", desc: "Tự do lựa chọn màu sơn ngoại thất và chất liệu bọc ghế da." },
        { title: "Tính toán mức trả góp linh hoạt", desc: "Trả trước chỉ từ 15% nhận xe ngay trong ngày." },
        { title: "Tặng bộ sạc siêu tốc 22kW", desc: "Lắp đặt miễn phí trụ sạc tận nhà cùng gói bảo dưỡng 3 năm." },
      ],
      ctaText: "Đăng Ký Lái Thử Xe Tận Nhà",
    },
  ];

  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;
---

<BaseLayout
  title={`${project.name} — Demo Landing Page`}
  description={project.detail}
>
  <!-- ===== HERO BANNERS ===== -->
  <section class="section-padding relative overflow-hidden water-pattern" id="project-hero">
    <div class="water-bubbles">
      <div class="bubble"></div><div class="bubble"></div><div class="bubble"></div>
      <div class="bubble"></div><div class="bubble"></div><div class="bubble"></div>
    </div>
    <div class="max-w-5xl mx-auto text-center relative z-10">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-ocean-50 border border-ocean-200 text-ocean-700 text-xs font-bold mb-6 shadow-sm">
        {project.badge}
      </div>

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-ocean-950 mb-6 leading-tight">
        {project.name} — <br />
        <span class={`bg-gradient-to-r ${project.gradient} bg-clip-text text-transparent`}>
          {project.headline}
        </span>
      </h1>

      <p class="text-lg md:text-xl text-slate-600 leading-relaxed max-w-3xl mx-auto mb-10">
        {project.detail}
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="#register" class="btn-primary">
          {project.ctaText}
        </a>
        <a href="/#du-an" class="btn-secondary">
          ← Quay Lại Portfolio
        </a>
      </div>
    </div>
  </section>

  <!-- ===== LIVE STATS PERFORMANCE METRICS ===== -->
  <section class="py-12 bg-white border-y border-ocean-100/60" id="project-stats">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {project.stats.map((s) => (
          <div class="water-card p-6 text-center">
            <div class="stat-number text-4xl lg:text-5xl font-extrabold text-ocean-600 mb-2" data-target={parseInt(s.value)} data-suffix={s.value.replace(/^[0-9]+/, '')}>{s.value}</div>
            <p class="text-slate-600 text-sm font-semibold">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== CORE FEATURES ===== -->
  <section class="section-padding gradient-section" id="project-features">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <span class="text-ocean-500 text-xs font-bold uppercase tracking-[0.2em]">TÍNH NĂNG NỔI BẬT</span>
        <h2 class="text-3xl md:text-4xl font-extrabold mt-3 mb-4 text-ocean-950">Giải pháp <span class="gradient-text">tối ưu chuyển đổi</span></h2>
        <p class="text-slate-500 text-lg max-w-2xl mx-auto">Được thiết kế riêng để mang lại doanh thu đột phá cho doanh nghiệp.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        {project.features.map((f, i) => (
          <div class="water-card p-8 flex items-start gap-5">
            <div class="w-12 h-12 rounded-2xl bg-ocean-50 flex items-center justify-center font-extrabold text-ocean-600 shrink-0 text-lg shadow-sm border border-ocean-100">
              0{i + 1}
            </div>
            <div>
              <h3 class="text-xl font-bold text-ocean-950 mb-2">{f.title}</h3>
              <p class="text-slate-600 text-sm leading-relaxed">{f.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== CONSULTATION FORM ===== -->
  <section class="section-padding bg-white" id="register">
    <div class="max-w-4xl mx-auto">
      <div class="water-card p-8 md:p-12 shadow-2xl border-ocean-200">
        <div class="text-center mb-10">
          <span class="text-ocean-500 text-xs font-bold uppercase tracking-[0.2em]">TƯ VẤN THIẾT KẾ</span>
          <h2 class="text-3xl font-extrabold text-ocean-950 mt-2 mb-3">Bạn muốn làm Landing Page tương tự {project.name}?</h2>
          <p class="text-slate-500 text-sm">Điền thông tin bên dưới, đội ngũ kỹ sư BluVy sẽ liên hệ tư vấn miễn phí trong 30 phút.</p>
        </div>
        <ContactForm formId={`project-${project.slug}-form`} />
      </div>
    </div>
  </section>
</BaseLayout>
