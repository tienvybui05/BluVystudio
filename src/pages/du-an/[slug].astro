        { title: "Công nghệ quét 3D iTero Element 5D", desc: "Xem trước kết quả niềng răng chuẩn xác chỉ sau 60 giây." },
        { title: "Trả góp 0% lãi suất hàng tháng", desc: "Hỗ trợ trả góp linh hoạt chỉ từ 1 triệu đồng/tháng." },
        { title: "Bảo hành trọn đời răng sứ", desc: "Cấp thẻ bảo hành chính hãng chính thức trên toàn quốc." },
      ],
      ctaText: "Đặt Lịch Khám & Tư Vấn Miễn Phí",
    },
    {
      slug: "nha-hang-pho-bac",
      name: "Phở Bắc Tradition",
      desc: "Landing Page Chuỗi Nhà Hàng Ẩm Thực Việt",
      category: "F&B / Nhà Hàng",
      pageSpeed: "97/100",
      badge: "🍜 CHUỖI NHÀ HÀNG ẨM THỰC TRUYỀN THỐNG",
      headline: "Hương Vị Phở Gia Truyền 3 Thế Hệ",
      gradient: "from-amber-500 via-orange-400 to-ocean-600",
      detail: "Nước dùng hầm từ xương bò tươi 24 giờ cùng bánh phở tráng tay thủ công mỗi ngày. Đặt bàn trước giảm 10%.",
      stats: [
        { value: "3,000+", label: "Lượt Đặt Bàn / Tháng" },
        { value: "4.8/5", label: "Đánh Giá TripAdvisor" },
        { value: "15 Phút", label: "Thời Gian Phục Vụ Nhanh" },
      ],
