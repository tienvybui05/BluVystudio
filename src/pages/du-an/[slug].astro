    {
      slug: "thoi-trang-lumia",
      name: "Lumia Organic Beauty",
      desc: "Landing Page Mỹ Phẩm & Skincare Thuần Chay",
      category: "E-Commerce",
      pageSpeed: "98/100",
      badge: "🌿 MỸ PHẨM THUẦN CHAY 100% ORGANIC",
      headline: "Tái Tạo Làn Da Trắng Sáng Tự Nhiên",
      gradient: "from-rose-500 via-pink-400 to-ocean-500",
      detail: "Chiết xuất từ thảo mộc hữu cơ thiên nhiên. Giúp mờ thâm nám, cấp ẩm 24h và chống lão hóa da vượt trội.",
      stats: [
        { value: "+250%", label: "Tăng Trưởng Doanh Thu" },
        { value: "12,000+", label: "Đơn Hàng Bán Ra" },
        { value: "4.9/5", label: "Đánh Giá Từ KOC" },
      ],
      features: [
        { title: "Chứng nhận KBY Organic Châu Âu", desc: "100% thành phần thảo mộc hữu cơ an toàn cho mọi làn da nhạy cảm." },
        { title: "Bộ sưu tập Mua 1 Tặng 1", desc: "Ưu đãi độc quyền cho 100 khách hàng đặt mua sớm nhất hôm nay." },
        { title: "Miễn phí giao hàng toàn quốc", desc: "Giao hàng hỏa tốc trong 2 giờ tại TP.HCM & Hà Nội." },
        { title: "Cam kết đổi trả 1-1 trong 30 ngày", desc: "Hoàn tiền 200% nếu phát hiện hàng giả hoặc kích ứng da." },
      ],
      ctaText: "Nhận Ưu Đãi Mua 1 Tặng 1 Ngay",
    },
    {
      slug: "nha-khoa-medcare",
      name: "MedCare Dental",
      desc: "Landing Page Nha Khoa Quốc Tế & Thẩm Mỹ",
      category: "Y Tế / Nha Khoa",
      pageSpeed: "100/100",
      badge: "🏥 NHA KHOA THẨM MỸ QUỐC TẾ",
      headline: "Nụ Cười Rạng Rỡ — Tự Tin Tỏa Sáng",
      gradient: "from-aqua-600 via-cyan-500 to-blue-600",
      detail: "Chuyên gia niềng răng trong suốt Invisalign, bọc răng sứ Nano và Trồng răng Implant tiêu chuẩn Châu Âu.",
      stats: [
        { value: "+180%", label: "Khách Đặt Lịch Online" },
