        { title: "Thực đơn 30+ món ngon truyền thống", desc: "Đa dạng các món phở bò tái lăn, phở gà ta, nem rán Hà Nội." },
        { title: "Đặt bàn VIP riêng tư gia đình", desc: "Không gian máy lạnh hiện đại sang trọng mang đậm dấu ấn Việt." },
        { title: "Voucher giảm 10% khi đặt trước", desc: "Nhận ngay mã ưu đãi giảm 10% tổng hóa đơn khi đặt bàn trước." },
        { title: "Đảm bảo vệ sinh ATTP chuẩn ISO", desc: "Nguồn nguyên liệu bò tươi thảo nguyên sạch 100%." },
      ],
      ctaText: "Đặt Bàn Trước Nhận Giảm 10%",
    },
    {
      slug: "edutech-academy",
      name: "EduTech Academy",
      desc: "Landing Page Học Viện Lập Trình & AI",
      category: "Giáo Dục / EdTech",
      pageSpeed: "99/100",
      badge: "🎓 HỌC VIỆN CÔNG NGHỆ & LẬP TRÌNH AI",
      headline: "Bứt Phá Sự Nghiệp Lập Trình Viên Fullstack",
      gradient: "from-indigo-600 via-purple-500 to-ocean-500",
      detail: "Lộ trình đào tạo 6 tháng thực chiến cùng chuyên gia Google & Tech Leads. Cam kết giới thiệu việc làm sau khóa học.",
      stats: [
        { value: "95%", label: "Học Viên Có Việc Làm" },
        { value: "2,500+", label: "Cựu Học Viên Tốt Nghiệp" },
        { value: "15M - 35M", label: "Mức Lương Khởi Điểm" },
      ],
      features: [
        { title: "Luyện code thực tế trên dự án thật", desc: "Xây dựng 5 dự án thực chiến chuẩn doanh nghiệp cho Portfolio." },
        { title: "Mentor 1-on-1 hỗ trợ 24/7", desc: "Đội ngũ Tech Leads trực tiếp code review và giải đáp thắc mắc." },
        { title: "Học thử miễn phí 7 ngày", desc: "Trải nghiệm phương pháp học chủ động không mất bất kỳ chi phí nào." },
        { title: "Cam kết giới thiệu việc làm", desc: "Kết nối tuyển dụng tới 150+ doanh nghiệp công nghệ đối tác." },
      ],
