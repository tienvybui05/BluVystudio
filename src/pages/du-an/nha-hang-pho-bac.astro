---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactForm from "../../components/ContactForm.astro";
---

<BaseLayout
  title="Phở Bắc Tradition — Chuỗi Nhà Hàng Phở Gia Truyền 3 Thế Hệ"
  description="Nước dùng hầm xương bò tươi 24 giờ cùng bánh phở tráng tay thủ công. Đặt bàn trước nhận ngay ưu đãi giảm 10% tổng hóa đơn."
>
  <!-- ===== DEMO PROJECT NAV HEADER ===== -->
  <div class="bg-amber-950 text-white py-2 px-4 text-xs flex justify-between items-center border-b border-amber-900/50">
    <div class="flex items-center gap-3">
      <span class="px-2.5 py-0.5 rounded-full bg-emerald-500 text-white font-bold tracking-wide">DEMO LIVE</span>
      <span class="text-amber-100 hidden sm:inline font-medium">Mẫu Landing Page Nhà Hàng F&B — Thiết kế bởi BluVy</span>
      <span class="text-amber-100 sm:hidden">Landing Page Nhà Hàng</span>
    </div>
    <a href="/#du-an" class="text-amber-300 hover:text-white font-semibold flex items-center gap-1.5 transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
      Quay về BluVy
    </a>
  </div>

  <!-- ===== HERO ===== -->
  <section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden bg-stone-950 pt-10 pb-20" id="pho-hero">
    <!-- Appetizing Food Background -->
    <div class="absolute inset-0 z-0">
      <img src="https://images.unsplash.com/photo-1582878826629-29b7ad1cdc43?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80" alt="Bát Phở Bò Bốc Khói" class="w-full h-full object-cover" />
      <!-- Dark overlay for text readability -->
      <div class="absolute inset-0 bg-gradient-to-r from-stone-950 via-stone-900/90 to-stone-900/40"></div>
      <!-- Vignette effect -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-transparent via-stone-950/20 to-stone-950/80 pointer-events-none"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <!-- Hero Content -->
        <div class="lg:col-span-7 animate-[fadeInUp_1s_ease-out_forwards]">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-amber-950/50 backdrop-blur-md border border-amber-500/30 text-amber-200 text-xs font-bold tracking-[0.1em] uppercase mb-6 shadow-sm">
            <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            PHỞ GIA TRUYỀN HÀ NỘI TỪ NĂM 1978
          </div>
          <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold mb-6 leading-[1.1] text-white tracking-tight">
            Tinh Hoa <br />
            <span class="bg-gradient-to-r from-amber-400 via-orange-400 to-amber-500 bg-clip-text text-transparent">Ẩm Thực Hà Thành</span>
          </h1>
          <p class="text-lg sm:text-xl text-stone-300 leading-relaxed mb-10 max-w-2xl font-light">
            Nước dùng thanh ngọt tự nhiên hầm từ xương ống bò tươi trong 24 giờ. Bánh phở tươi tráng tay thủ công mỗi sáng cùng những thớ thịt bò thảo nguyên mềm mượt.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 mb-12">
            <a href="#reservation" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-gradient-to-r from-amber-500 to-orange-600 text-white font-bold rounded-xl hover:from-amber-600 hover:to-orange-700 hover:scale-105 hover:shadow-[0_10px_40px_-10px_rgba(245,158,11,0.5)] transition-all duration-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/></svg>
              Đặt Bàn Trực Tuyến
            </a>
            <a href="#menu" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white/5 backdrop-blur-md border border-white/10 text-white font-bold rounded-xl hover:bg-white/10 transition-all duration-300">
              Xem Thực Đơn
            </a>
          </div>

          <div class="flex items-center gap-8 pt-8 border-t border-stone-800">
            <div class="text-center">
              <div class="text-3xl font-bold text-amber-500">24h</div>
              <div class="text-xs text-stone-400 uppercase tracking-widest mt-1">Ninh Xương</div>
            </div>
            <div class="w-px h-10 bg-stone-800"></div>
            <div class="text-center">
              <div class="text-3xl font-bold text-amber-500">100%</div>
              <div class="text-xs text-stone-400 uppercase tracking-widest mt-1">Bò Tươi</div>
            </div>
            <div class="w-px h-10 bg-stone-800"></div>
            <div class="text-center">
              <div class="text-3xl font-bold text-amber-500">1978</div>
              <div class="text-xs text-stone-400 uppercase tracking-widest mt-1">Gia Truyền</div>
            </div>
          </div>
        </div>

        <!-- Hero Form Card -->
        <div class="lg:col-span-5 w-full max-w-md mx-auto lg:ml-auto animate-[fadeInUp_1s_ease-out_0.3s_forwards] opacity-0 relative">
          <div class="bg-stone-900/80 backdrop-blur-2xl border border-stone-700/50 p-8 rounded-[2rem] shadow-[0_30px_60px_-15px_rgba(0,0,0,0.8)] relative z-10">
            <div class="absolute top-0 right-0 w-32 h-32 bg-amber-500/10 rounded-full blur-2xl pointer-events-none" aria-hidden="true"></div>
            <div class="text-center mb-6 relative z-10">
              <h3 class="text-2xl font-bold text-white mb-2">Giữ Chỗ Tại Quán</h3>
              <p class="text-amber-400 text-sm font-medium">Tặng nước sấu chua ngọt & Giảm 10% hóa đơn khi đặt trước.</p>
            </div>

            <div class="dark-form-wrapper relative z-10">
              <ContactForm formId="pho-reservation-form" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== POPULAR DISHES ===== -->
  <section class="py-24 bg-stone-50 relative" id="menu">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-16 max-w-3xl mx-auto">
        <span class="text-amber-600 text-sm font-bold uppercase tracking-[0.2em] mb-3 block">Thực Đơn Đặc Sản</span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-stone-900 mb-6 tracking-tight">Hương Vị <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-600 to-orange-500">Gây Thương Nhớ</span></h2>
        <p class="text-lg text-stone-600 leading-relaxed">Mỗi bát phở là một tác phẩm nghệ thuật ẩm thực, kết tinh từ những nguyên liệu tươi ngon nhất trong ngày.</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {[
          { name: "Phở Bò Tái Lăn", desc: "Thịt bò thăn hoa xào nhanh trên lửa lớn rực cùng tỏi và hành lá rơm ngọt lịm.", price: "75.000đ", tag: "Must Try", img: "https://images.unsplash.com/photo-1631515243349-e0cb75fb8d3a?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" },
          { name: "Phở Thố Đá Đặc Biệt", desc: "Bát thố đá giữ nhiệt 100°C sôi sục với bò tái, nạm, gầu, gân và sườn bò nguyên tảng.", price: "115.000đ", tag: "Signature", img: "https://images.unsplash.com/photo-1547592180-85f173990554?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" },
          { name: "Phở Gà Ta Mái Đẻ", desc: "Thịt gà thả vườn da vàng giòn sần sật, điểm xuyết lá chanh tươi thái chỉ thơm lừng.", price: "65.000đ", tag: "Thanh Đạm", img: "https://images.unsplash.com/photo-1594998893017-36147cbcae05?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" },
        ].map((dish) => (
          <div class="group bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-[0_20px_40px_-15px_rgba(245,158,11,0.15)] transition-all duration-300 border border-stone-100 flex flex-col">
            <div class="h-56 overflow-hidden relative">
              <div class="absolute top-4 left-4 z-20 px-3 py-1 rounded-full bg-amber-500 text-white text-xs font-bold tracking-wider uppercase shadow-sm">
                {dish.tag}
              </div>
              <div class="absolute inset-0 bg-stone-900/10 group-hover:bg-transparent transition-colors duration-500 z-10"></div>
              <img src={dish.img} alt={dish.name} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
            </div>

            <div class="p-8 flex flex-col flex-grow">
              <h3 class="text-2xl font-bold text-stone-900 mb-3">{dish.name}</h3>
              <p class="text-stone-600 text-sm leading-relaxed mb-6">{dish.desc}</p>

              <div class="mt-auto pt-6 border-t border-stone-100 flex items-center justify-between">
                <div class="text-2xl font-black text-amber-600">{dish.price}</div>
                <a href="#reservation" class="w-10 h-10 rounded-full bg-stone-100 text-stone-600 flex items-center justify-center group-hover:bg-amber-500 group-hover:text-white transition-colors duration-300" aria-label="Đặt món này">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== RESERVATION FORM ===== -->
  <section class="py-24 bg-stone-950 relative overflow-hidden" id="reservation">
    <div class="absolute inset-0 opacity-5 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0MCIgaGVpZ2h0PSI0MCI+PHBhdGggZD0iTTIwIDIwYy0xMSAwLTIwLTktMjAtMjB2MjBjMCAxMSA5IDIwIDIwIDIwczIwLTkgMjAtMjB2LTIwYzAtMTEtOS0yMC0yMC0yMHoiIGZpbGw9IiNmZmYiIGZpbGwtb3BhY2l0eT0iMC41Ii8+PC9zdmc+')] pointer-events-none" aria-hidden="true"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="bg-stone-900 border border-stone-800 p-8 sm:p-12 rounded-[2.5rem] shadow-2xl relative overflow-hidden text-center">
        <!-- Glow effects -->
        <div class="absolute -top-32 -left-32 w-64 h-64 bg-orange-500/20 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
        <div class="absolute -bottom-32 -right-32 w-64 h-64 bg-amber-500/20 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

        <div class="text-center mb-10 max-w-2xl mx-auto relative z-10">
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white mb-4 tracking-tight">Đặt Bàn Trực Tuyến Ngay</h2>
          <p class="text-stone-400">Tránh phải xếp hàng chờ đợi vào giờ cao điểm. Đặt trước để nhà hàng chuẩn bị phục vụ bạn chu đáo nhất.</p>
        </div>

        <div class="relative z-10 max-w-xl mx-auto text-left">
          <div class="dark-form-wrapper">
            <ContactForm formId="pho-form-footer" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* Dark Theme Form Styling for Hero and Footer */
    .dark-form-wrapper :global(input),
    .dark-form-wrapper :global(textarea) {
      background-color: rgba(255, 255, 255, 0.05);
      border-color: rgba(255, 255, 255, 0.1);
      color: white;
      border-radius: 0.75rem;
    }
    .dark-form-wrapper :global(input::placeholder),
    .dark-form-wrapper :global(textarea::placeholder) {
      color: rgba(255, 255, 255, 0.4);
    }
    .dark-form-wrapper :global(input:focus),
    .dark-form-wrapper :global(textarea:focus) {
      border-color: #f59e0b; /* amber-500 */
      background-color: rgba(255, 255, 255, 0.1);
      box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.2);
    }
    .dark-form-wrapper :global(label) {
      color: rgba(255, 255, 255, 0.8);
      font-weight: 500;
    }
    .dark-form-wrapper :global(button) {
      background: linear-gradient(to right, #f59e0b, #ea580c); /* amber-500 to orange-600 */
      border: none;
      color: white;
      font-weight: bold;
      border-radius: 0.75rem;
      padding-top: 0.875rem;
      padding-bottom: 0.875rem;
      margin-top: 0.5rem;
      transition: all 0.3s;
    }
    .dark-form-wrapper :global(button:hover) {
      background: linear-gradient(to right, #d97706, #c2410c);
      transform: translateY(-2px);
      box-shadow: 0 10px 25px -5px rgba(245, 158, 11, 0.4);
    }
  </style>
</BaseLayout>