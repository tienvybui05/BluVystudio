---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";

const partners = [
  { name: "FinTech Corp", icon: "💳" },
  { name: "Phở Bắc", icon: "🍜" },
  { name: "MedCare", icon: "🏥" },
  { name: "EduTech VN", icon: "🎓" },
  { name: "AutoViet", icon: "🚗" },
  { name: "Grand Hotel", icon: "🏨" },
  { name: "ShopFast", icon: "🛒" },
  { name: "SpaCare", icon: "🌿" },
];
---

<BaseLayout
  title="Thiết Kế Website & Landing Page Chuyên Nghiệp, Chuẩn SEO"
  description="Thiết kế Website & Landing Page chuyên nghiệp, chuẩn SEO, tải nhanh dưới 2 giây. Tặng Domain + Hosting 1 năm. Cam kết bàn giao đúng hẹn."
>
  <!-- ===== HERO ===== -->
  <section class="relative overflow-hidden section-padding !pb-12 water-pattern" id="hero">
    <!-- Water Bubbles Background (Layered behind text z-0) -->
    <div class="water-bubbles">
      <div class="bubble"></div><div class="bubble"></div><div class="bubble"></div>
      <div class="bubble"></div><div class="bubble"></div><div class="bubble"></div>
      <div class="bubble"></div><div class="bubble"></div><div class="bubble"></div>
      <div class="bubble"></div><div class="bubble"></div><div class="bubble"></div>
    </div>

    <!-- Decorative Orbs -->
    <div class="absolute top-20 right-[10%] w-72 h-72 bg-ocean-200/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-10 left-[5%] w-96 h-96 bg-aqua-200/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] opacity-30 pointer-events-none">
      <div class="orbit-ring w-full h-full"></div>
      <div class="orbit-ring w-[80%] h-[80%] top-[10%] left-[10%]" style="animation-direction: reverse; animation-duration: 35s;"></div>
    </div>

    <div class="max-w-7xl mx-auto relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <!-- Left -->
        <div class="animate-fade-in-up">
          <div class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-ocean-50 border border-ocean-200 mb-8 shadow-sm">
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-ocean-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-ocean-500"></span>
            </span>
            <span class="text-sm font-semibold text-ocean-700">Ưu đãi — Tặng Domain + Hosting 1 năm</span>
          </div>

          <h1 class="text-4xl md:text-5xl lg:text-[3.5rem] font-extrabold leading-[1.1] mb-6 text-ocean-950">
            Đừng để website
            <span class="gradient-text"> chậm & cũ</span>
            <br />giết chết
            <span class="gradient-text"> doanh thu</span>
          </h1>

          <p class="text-lg md:text-xl text-slate-600 leading-relaxed mb-8 max-w-xl">
            Chúng tôi thiết kế Website & Landing Page <strong class="text-ocean-800">tải nhanh dưới 2 giây</strong>,
            chuẩn SEO 100%, giúp <strong class="text-ocean-800">tăng chuyển đổi lên đến 300%</strong>.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 mb-10">
            <a href="/bang-gia" class="btn-primary text-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
              Xem Bảng Giá
            </a>
            <div class="flex items-center gap-3 bg-white border border-ocean-100 px-5 py-3 rounded-2xl shadow-sm text-center justify-center">
              <span class="text-2xl">📞</span>
              <div class="text-left">
                <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wide">Hotline Tư Vấn</div>
                <a href="tel:0362567759" class="font-extrabold text-ocean-900 text-lg hover:text-ocean-600 transition-colors">0362.567.759</a>
              </div>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-6 text-sm text-slate-500">
            <div class="flex items-center gap-2"><svg class="w-5 h-5 text-ocean-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg><span class="font-medium">150+ dự án</span></div>
            <div class="flex items-center gap-2"><svg class="w-5 h-5 text-ocean-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg><span class="font-medium">4.9/5 đánh giá</span></div>
            <div class="flex items-center gap-2"><svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg><span class="font-medium">Bảo hành 12 tháng</span></div>
          </div>
        </div>

        <!-- Right — Ultra-Premium Browser Mockup -->
        <div class="relative animate-fade-in-up animation-delay-400 mt-6 lg:mt-0">
          <div class="relative max-w-lg mx-auto">
            <!-- Glass card container -->
            <div class="rounded-2xl border border-ocean-200/80 bg-white shadow-2xl shadow-ocean-300/20 overflow-hidden relative z-10">
              <!-- Browser Header -->
              <div class="flex items-center justify-between px-4 py-3 bg-slate-50/80 border-b border-ocean-100/80 backdrop-blur-md">
                <div class="flex items-center gap-2">
                  <div class="w-3 h-3 rounded-full bg-rose-400"></div>
                  <div class="w-3 h-3 rounded-full bg-amber-400"></div>
                  <div class="w-3 h-3 rounded-full bg-emerald-400"></div>
                </div>
                <div class="px-4 py-1 bg-white rounded-lg border border-ocean-100 text-xs font-medium text-slate-600 flex items-center gap-2 shadow-xs">
                  <svg class="w-3.5 h-3.5 text-emerald-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
                  <span class="text-ocean-900 font-semibold">https://</span>bluvy.io.vn
                </div>
                <div class="px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-600 border border-emerald-200 text-[10px] font-bold">
                  ● 100% SSG
                </div>
              </div>

              <!-- Browser Main Body -->
              <div class="p-6 bg-gradient-to-br from-ocean-50/60 via-white to-aqua-50/40">
                <!-- Main Speed Gauge Card -->
                <div class="bg-white rounded-xl p-5 border border-ocean-100 shadow-md mb-4 text-center relative overflow-hidden">
                  <div class="absolute -right-8 -top-8 w-28 h-28 bg-ocean-100/50 rounded-full blur-xl pointer-events-none"></div>
                  
                  <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-ocean-50 text-ocean-700 text-xs font-bold mb-4 border border-ocean-200/60">
                    ⚡ Google PageSpeed Insights
                  </div>

                  <!-- Big Scores -->
                  <div class="grid grid-cols-3 gap-3 mb-4">
                    <div class="p-3 rounded-xl bg-emerald-50/70 border border-emerald-100 text-center">
                      <div class="text-3xl font-extrabold text-emerald-600">98</div>
                      <div class="text-[11px] font-semibold text-emerald-800 uppercase tracking-wider mt-0.5">Performance</div>
                    </div>
                    <div class="p-3 rounded-xl bg-ocean-50/70 border border-ocean-100 text-center">
                      <div class="text-3xl font-extrabold text-ocean-600">100</div>
                      <div class="text-[11px] font-semibold text-ocean-800 uppercase tracking-wider mt-0.5">SEO On-Page</div>
                    </div>
                    <div class="p-3 rounded-xl bg-aqua-50/70 border border-aqua-100 text-center">
                      <div class="text-3xl font-extrabold text-aqua-600">100</div>
                      <div class="text-[11px] font-semibold text-aqua-800 uppercase tracking-wider mt-0.5">Accessibility</div>
                    </div>
                  </div>

                  <!-- Core Web Vitals Row -->
                  <div class="flex items-center justify-between px-3 py-2 rounded-lg bg-slate-50 text-xs border border-slate-100 text-slate-600">
                    <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-emerald-500"></span>LCP: <strong class="text-slate-800">0.6s</strong></span>
                    <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-emerald-500"></span>FID: <strong class="text-slate-800">12ms</strong></span>
                    <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-emerald-500"></span>CLS: <strong class="text-slate-800">0.00</strong></span>
                  </div>
                </div>

                <!-- Footer Feature Bar inside Mockup -->
                <div class="flex items-center justify-between text-xs text-slate-500 px-1">
                  <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Zero JS Payload</span>
                  <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-ocean-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg> CDN Vercel Global</span>
                </div>
              </div>
            </div>

            <!-- Floating Pill Badge 1 (Top-Right) -->
            <div class="absolute -top-5 -right-5 z-20 inline-flex items-center gap-3 px-4 py-3 rounded-2xl bg-white/95 backdrop-blur-md border border-ocean-200 shadow-xl shadow-ocean-300/20 animate-float animation-delay-200">
              <div class="w-9 h-9 rounded-xl bg-emerald-100 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-emerald-600" fill="currentColor" viewBox="0 0 24 24"><path d="M13 7h-2v4H7v2h4v4h2v-4h4v-2h-4V7zm-1-5C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/></svg>
              </div>
              <div class="pr-1 whitespace-nowrap">
                <p class="text-ocean-950 font-extrabold text-sm leading-tight">+300%</p>
                <p class="text-slate-500 text-xs font-medium">Chuyển đổi</p>
              </div>
            </div>

            <!-- Floating Pill Badge 2 (Bottom-Left) -->
            <div class="absolute -bottom-5 -left-5 z-20 inline-flex items-center gap-3 px-4 py-3 rounded-2xl bg-white/95 backdrop-blur-md border border-ocean-200 shadow-xl shadow-ocean-300/20 animate-float animation-delay-600">
              <div class="w-9 h-9 rounded-xl bg-ocean-100 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-ocean-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div class="pr-1 whitespace-nowrap">
                <p class="text-ocean-950 font-extrabold text-sm leading-tight">&lt; 1.2s</p>
                <p class="text-slate-500 text-xs font-medium">Tải trang cực tốc</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== MARQUEE PARTNER LOGOS (SLIDING INFINITELY - SCREENSHOT 1) ===== -->
  <section class="py-10 bg-gradient-to-b from-ocean-50/60 via-white to-ocean-50/40 overflow-hidden relative" id="doi-tac">
    <div class="max-w-7xl mx-auto px-4 mb-6 text-center">
      <p class="text-xs font-bold text-slate-400 uppercase tracking-[0.2em]">TIN TƯỞNG BỞI HÀNG TRĂM DOANH NGHIỆP VIỆT NAM</p>
    </div>
    <div class="relative w-full overflow-hidden flex">
      <!-- Gradient Fades on edges -->
      <div class="absolute left-0 top-0 bottom-0 w-24 bg-gradient-to-r from-white to-transparent z-10 pointer-events-none"></div>
      <div class="absolute right-0 top-0 bottom-0 w-24 bg-gradient-to-l from-white to-transparent z-10 pointer-events-none"></div>

      <!-- Infinite Marquee Track -->
      <div class="animate-marquee flex items-center gap-6 shrink-0">
        {[...partners, ...partners, ...partners, ...partners].map((p, i) => (
          <div key={i} class="flex items-center gap-3 px-6 py-3 rounded-full bg-ocean-50/60 border border-ocean-100 hover:border-ocean-300 transition-all cursor-pointer hover:scale-105 shrink-0">
            <span class="text-xl">{p.icon}</span>
            <span class="text-sm font-bold text-ocean-900 whitespace-nowrap">{p.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== 3D WATER WAVE DIVIDER ===== -->
  <div class="relative w-full overflow-hidden leading-none z-10 -mt-2 -mb-2 pointer-events-none">
    <svg class="relative block w-full h-[70px] md:h-[95px] scale-y-[1.08] origin-bottom" viewBox="0 0 1200 120" preserveAspectRatio="none">
      <defs>
        <linearGradient id="ocean-wave-grad-1" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.35"/>
          <stop offset="50%" stop-color="#06b6d4" stop-opacity="0.25"/>
          <stop offset="100%" stop-color="#0284c7" stop-opacity="0.35"/>
        </linearGradient>
        <linearGradient id="ocean-wave-grad-2" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#bfdbfe" stop-opacity="0.55"/>
          <stop offset="50%" stop-color="#7dd3fc" stop-opacity="0.45"/>
          <stop offset="100%" stop-color="#93c5fd" stop-opacity="0.55"/>
        </linearGradient>
      </defs>
      <path d="M0,0 C150,90 350,-30 500,45 C650,120 900,10 1200,35 L1200,130 L0,130 Z" fill="url(#ocean-wave-grad-1)"></path>
      <path d="M0,20 C200,65 450,15 700,55 C950,100 1100,25 1200,45 L1200,130 L0,130 Z" fill="url(#ocean-wave-grad-2)"></path>
      <path d="M0,45 C180,90 400,28 650,70 C900,115 1050,42 1200,60 L1200,130 L0,130 Z" fill="#ffffff"></path>
    </svg>
  </div>

  <!-- ===== VỀ CHÚNG TÔI (ABOUT US SECTION ON HOME PAGE) ===== -->
  <section class="section-padding bg-white relative overflow-hidden" id="ve-chung-toi">
    <div class="water-bubbles">
      <div class="bubble"></div><div class="bubble"></div><div class="bubble"></div>
    </div>
    <div class="max-w-7xl mx-auto relative z-10">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <!-- Left: Story & Mission -->
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-ocean-50 text-ocean-700 text-xs font-bold mb-6 border border-ocean-200 shadow-sm">
            ✨ VỀ CHÚNG TÔI
          </div>
          
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-ocean-950 mb-6 leading-tight">
            Đội Ngũ Kỹ Sư Web <br class="hidden sm:inline" />
            <span class="gradient-text">Tận Tâm & Chuyên Nghiệp</span>
          </h2>
          
          <p class="text-slate-600 text-lg leading-relaxed mb-6">
            <strong class="text-ocean-900 font-bold">BluVy</strong> là đơn vị tiên phong áp dụng công nghệ <strong class="text-ocean-900">Astro SSG hiện đại</strong> tại Việt Nam, mang đến những giải pháp thiết kế website & landing page đột phá với tốc độ siêu tốc dưới 2 giây.
          </p>

          <p class="text-slate-600 text-base leading-relaxed mb-8">
            Chúng tôi không chỉ bán giao diện web đơn thuần — chúng tôi tạo dựng <strong class="text-ocean-900 font-bold">công thức tăng trưởng doanh thu</strong> bền vững cho các chủ doanh nghiệp, thương hiệu và nhà bán hàng online.
          </p>

          <!-- 3 Highlights Grid -->
          <div class="grid sm:grid-cols-3 gap-4 mb-8">
            <div class="p-4 rounded-2xl bg-ocean-50/70 border border-ocean-100">
              <div class="w-10 h-10 rounded-xl bg-ocean-500 text-white flex items-center justify-center font-bold mb-3 shadow-md">⚡</div>
              <h3 class="font-bold text-ocean-950 text-sm mb-1">Siêu Tốc Độ</h3>
              <p class="text-slate-500 text-xs">Load dưới 2s, Google Lighthouse 95+</p>
            </div>

            <div class="p-4 rounded-2xl bg-aqua-50/70 border border-aqua-100">
              <div class="w-10 h-10 rounded-xl bg-aqua-500 text-white flex items-center justify-center font-bold mb-3 shadow-md">🎯</div>
              <h3 class="font-bold text-ocean-950 text-sm mb-1">Chuẩn SEO 100%</h3>
              <p class="text-slate-500 text-xs">Dễ dàng lên TOP tìm kiếm Google</p>
            </div>

            <div class="p-4 rounded-2xl bg-blue-50/70 border border-blue-100">
              <div class="w-10 h-10 rounded-xl bg-blue-500 text-white flex items-center justify-center font-bold mb-3 shadow-md">🤝</div>
              <h3 class="font-bold text-ocean-950 text-sm mb-1">Đồng Hành 24/7</h3>
              <p class="text-slate-500 text-xs">Bảo hành 12 tháng, hỗ trợ tận tâm</p>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <a href="/gioi-thieu" class="btn-primary">
              Tìm Hiểu Thêm Về Chúng Tôi
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
          </div>
        </div>

        <!-- Right: Glass Visual Showcase -->
        <div class="lg:col-span-5 relative mt-10 lg:mt-0 flex justify-center lg:justify-end">
          <div class="relative w-full max-w-[400px]">
            <!-- Background Decorative Glow -->
            <div class="absolute inset-0 bg-gradient-to-tr from-ocean-300/40 to-aqua-300/40 rounded-3xl blur-2xl transform -rotate-3 scale-105"></div>

            <div class="water-card p-2 relative z-10 border-ocean-200/90 shadow-2xl">
              <img 
                src="/uploads/ui_ux_design.jpg" 
                alt="Thiết kế UI UX chuyên nghiệp" 
                class="w-full aspect-[4/3] rounded-[18px] object-cover transition-transform duration-700 hover:scale-[1.02]"
                loading="lazy"
              />
            </div>

            <!-- Floating Badge -->
            <div class="absolute -bottom-5 -left-4 sm:-left-10 z-20 px-4 py-3 rounded-2xl bg-white/95 backdrop-blur-md border border-ocean-200 shadow-xl flex items-center gap-3 transform hover:-translate-y-1 transition-transform">
              <span class="text-3xl">🚀</span>
              <div>
                <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Tải trang siêu tốc</p>
                <p class="text-sm font-extrabold text-ocean-900">Chốt sale ầm ầm</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 4 TIÊU CHÍ CỐT LÕI (SCREENSHOT 3) ===== -->
  <section class="section-padding bg-white relative overflow-hidden" id="cam-ket">
    <div class="water-bubbles">
      <div class="bubble"></div><div class="bubble"></div><div class="bubble"></div>
      <div class="bubble"></div><div class="bubble"></div><div class="bubble"></div>
    </div>
    <div class="max-w-7xl mx-auto relative z-10">
      <div class="text-center mb-16">
        <span class="text-ocean-500 text-xs font-bold uppercase tracking-[0.2em]">CAM KẾT</span>
        <h2 class="text-3xl md:text-4xl font-extrabold mt-3 mb-4 text-ocean-950">4 tiêu chí <span class="gradient-text">cốt lõi</span></h2>
        <p class="text-slate-500 text-lg max-w-2xl mx-auto">Mỗi dự án chúng tôi nhận đều phải đạt cả 4 tiêu chí này.</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="water-card p-8 group text-center flex flex-col items-center">
          <div class="w-16 h-16 rounded-2xl bg-ocean-50 flex items-center justify-center mb-6 group-hover:bg-ocean-100 transition-all">
            <svg class="w-8 h-8 text-ocean-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h3 class="text-lg font-bold text-ocean-950 mb-2">Tải trang &lt; 2 giây</h3>
          <p class="text-slate-500 text-sm leading-relaxed">PageSpeed Performance Score luôn đạt 95+ điểm.</p>
        </div>

        <div class="water-card p-8 group text-center flex flex-col items-center">
          <div class="w-16 h-16 rounded-2xl bg-aqua-50 flex items-center justify-center mb-6 group-hover:bg-aqua-100 transition-all">
            <svg class="w-8 h-8 text-aqua-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="text-lg font-bold text-ocean-950 mb-2">SEO kỹ thuật 100%</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Đạt điểm tuyệt đối các chỉ số SEO của Google Lighthouse.</p>
        </div>

        <div class="water-card p-8 group text-center flex flex-col items-center">
