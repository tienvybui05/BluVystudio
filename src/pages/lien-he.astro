---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
---

<BaseLayout
  title="Liên Hệ"
  description="Liên hệ BluVy để được tư vấn miễn phí về thiết kế website & landing page. Hotline: 0362.567.759. Email: support@bluvy.io.vn"
>
  <!-- ===== HERO ===== -->
  <section class="section-padding relative overflow-hidden !pb-12 water-pattern" id="lien-he-hero">
    <div class="water-bubbles">
      <div class="bubble"></div><div class="bubble"></div><div class="bubble"></div>
      <div class="bubble"></div><div class="bubble"></div><div class="bubble"></div>
    </div>
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <span class="text-ocean-500 text-sm font-semibold uppercase tracking-widest">Liên hệ</span>
      <h1 class="text-4xl md:text-5xl font-extrabold mt-3 mb-6 text-ocean-950">
        Hãy để chúng tôi <span class="gradient-text">giúp bạn</span>
      </h1>
      <p class="text-lg md:text-xl text-slate-600 leading-relaxed max-w-3xl mx-auto">
        Tư vấn miễn phí, báo giá trong 24h. Đừng ngần ngại liên hệ bất cứ lúc nào.
      </p>
    </div>
  </section>

  <!-- ===== CONTACT SECTION ===== -->
  <section class="section-padding !pt-8 bg-white" id="form-lien-he">
    <div class="max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-5 gap-12 lg:gap-16">
        <!-- Contact Info -->
        <div class="lg:col-span-2 space-y-6">
          <!-- Phone -->
          <div class="water-card p-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-ocean-50 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-ocean-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <h3 class="font-bold text-ocean-900 mb-1">Hotline</h3>
                <a href="tel:0362567759" class="text-ocean-600 hover:underline text-lg font-bold">0362.567.759</a>
                <p class="text-slate-500 text-xs mt-1">Gọi ngay để được tư vấn</p>
              </div>
            </div>
          </div>

          <!-- Zalo -->
          <div class="water-card p-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-blue-50 flex items-center justify-center shrink-0">
                <span class="text-blue-600 font-bold text-sm">Zalo</span>
              </div>
              <div>
                <h3 class="font-bold text-ocean-900 mb-1">Chat Zalo</h3>
                <a href="https://zalo.me/0362567759" target="_blank" rel="noopener" class="text-blue-600 hover:underline font-semibold">zalo.me/0362567759</a>
                <p class="text-slate-500 text-xs mt-1">Chat trực tiếp, phản hồi nhanh</p>
              </div>
            </div>
          </div>

          <!-- Email -->
          <div class="water-card p-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-aqua-50 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-aqua-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <h3 class="font-bold text-ocean-900 mb-1">Email</h3>
                <a href="mailto:support@bluvy.io.vn" class="text-aqua-600 hover:underline font-semibold">support@bluvy.io.vn</a>
                <p class="text-slate-500 text-xs mt-1">Gửi email 24/7</p>
              </div>
            </div>
          </div>

          <!-- Address -->
          <div class="water-card p-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-emerald-50 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <h3 class="font-bold text-ocean-900 mb-1">Địa chỉ</h3>
                <p class="text-slate-600 text-sm">TP. Hồ Chí Minh, Việt Nam</p>
              </div>
            </div>
          </div>

          <!-- Working Hours -->
          <div class="water-card p-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-amber-50 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <h3 class="font-bold text-ocean-900 mb-1">Giờ làm việc</h3>
                <p class="text-slate-600 text-sm">Thứ 2 - Thứ 7: 8:00 - 18:00</p>
                <p class="text-slate-500 text-xs mt-1">Chủ nhật: Hỗ trợ qua Zalo/Email</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="lg:col-span-3">
          <div class="water-card p-8 md:p-10 sticky top-24 shadow-xl shadow-ocean-100/40">
            <h2 class="text-2xl font-bold text-ocean-950 mb-2">Gửi yêu cầu tư vấn</h2>
            <p class="text-slate-500 text-sm mb-8">Điền thông tin bên dưới, chúng tôi sẽ liên hệ trong vòng 30 phút (giờ hành chính).</p>
            <ContactForm formId="page-contact-form" />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
