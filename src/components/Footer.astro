---
const currentYear = new Date().getFullYear();
const quickLinks = [
  { href: "/", label: "Trang chủ" },
  { href: "/gioi-thieu", label: "Giới thiệu" },
  { href: "/dich-vu", label: "Dịch vụ" },
  { href: "/bang-gia", label: "Bảng giá" },
  { href: "/blog", label: "Blog" },
  { href: "/lien-he", label: "Liên hệ" },
];
const services = ["Thiết kế Landing Page", "Website Doanh Nghiệp", "Tối ưu PageSpeed", "Web Bán Hàng"];
---

<footer class="relative overflow-hidden" id="main-footer">
  <!-- Smooth Wave Divider into Footer -->
  <div class="relative w-full overflow-hidden leading-none z-10 -mb-1 pointer-events-none">
    <svg class="relative block w-full h-[50px] md:h-[75px] scale-y-[1.05] origin-bottom" viewBox="0 0 1200 120" preserveAspectRatio="none">
      <path d="M0,0 C150,90 350,-30 500,45 C650,120 900,10 1200,35 L1200,130 L0,130 Z" fill="#082f49" opacity="0.4"></path>
      <path d="M0,30 C200,80 450,20 700,60 C950,110 1100,35 1200,50 L1200,130 L0,130 Z" fill="#0c4a6e" opacity="0.6"></path>
      <path d="M0,55 C180,95 400,35 650,75 C900,120 1050,50 1200,68 L1200,130 L0,130 Z" fill="#082f49"></path>
    </svg>
  </div>

  <div class="bg-ocean-950 text-white relative z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
        <!-- Brand -->
        <div class="lg:col-span-1">
          <a href="/" class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 shrink-0">
              <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
                <defs>
                  <linearGradient id="ftr-b-grad" x1="0" y1="0" x2="40" y2="40" gradientUnits="userSpaceOnUse">
                    <stop offset="0%" stop-color="#00D4FF"/>
                    <stop offset="100%" stop-color="#0066FF"/>
                  </linearGradient>
                </defs>
                <rect width="40" height="40" rx="12" fill="url(#ftr-b-grad)"/>
                <path d="M12 10h10c3.5 0 6 2 6 5.5 0 1.5-.6 2.8-1.6 3.7C28.3 20.3 29 22 29 24c0 3.5-2.5 6-7 6H12V10z" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M12 20h9" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
              </svg>
            </div>
            <div class="flex flex-col">
              <span class="text-lg font-bold text-white leading-tight">Blu<span class="text-transparent bg-clip-text bg-gradient-to-r from-[#00D4FF] to-[#8B5CF6]">Vy</span></span>
              <span class="text-[10px] text-ocean-300 tracking-[0.2em] uppercase -mt-0.5">Web Studio</span>
            </div>
          </a>
          <p class="text-ocean-200/70 text-sm leading-relaxed mb-6">Thiết kế Website & Landing Page chuyên nghiệp, chuẩn SEO, tải nhanh dưới 2 giây.</p>
          <div class="flex items-center gap-3">
            <a href="#" class="w-10 h-10 rounded-xl bg-white/5 hover:bg-ocean-500/20 flex items-center justify-center text-ocean-300 hover:text-ocean-200 transition-all" aria-label="Facebook">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a href="#" class="w-10 h-10 rounded-xl bg-white/5 hover:bg-ocean-500/20 flex items-center justify-center text-ocean-300 hover:text-ocean-200 transition-all" aria-label="YouTube">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>
            <a href="https://zalo.me/0362567759" class="w-10 h-10 rounded-xl bg-white/5 hover:bg-blue-500/20 flex items-center justify-center text-ocean-300 hover:text-blue-300 transition-all" aria-label="Zalo" target="_blank" rel="noopener">
              <span class="font-bold text-xs">Zalo</span>
            </a>
          </div>
        </div>

        <!-- Quick Links -->
        <div>
          <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-6">Liên kết nhanh</h3>
          <ul class="space-y-3">
            {quickLinks.map((link) => (
              <li><a href={link.href} class="text-ocean-200/60 hover:text-white text-sm transition-colors">{link.label}</a></li>
            ))}
          </ul>
        </div>

        <!-- Services -->
        <div>
          <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-6">Dịch vụ</h3>
          <ul class="space-y-3">
            {services.map((s) => (
              <li><a href="/dich-vu" class="text-ocean-200/60 hover:text-white text-sm transition-colors">{s}</a></li>
            ))}
          </ul>
        </div>

        <!-- Contact -->
        <div>
          <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-6">Liên hệ</h3>
          <ul class="space-y-4 text-sm text-ocean-200/60">
            <li class="flex items-start gap-3"><svg class="w-5 h-5 text-ocean-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg><span>TP. Hồ Chí Minh, Việt Nam</span></li>
            <li><a href="tel:0362567759" class="flex items-start gap-3 hover:text-white transition-colors"><svg class="w-5 h-5 text-ocean-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg><span>0362.567.759</span></a></li>
            <li><a href="mailto:support@bluvy.io.vn" class="flex items-start gap-3 hover:text-white transition-colors"><svg class="w-5 h-5 text-ocean-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg><span>support@bluvy.io.vn</span></a></li>
            <li class="flex items-start gap-3"><svg class="w-5 h-5 text-ocean-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg><span>T2 - T7: 8:00 - 18:00</span></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom (Soft Gradient Line) -->
    <div class="relative">
      <div class="h-[1px] bg-gradient-to-r from-transparent via-white/15 to-transparent"></div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-ocean-200/50 text-sm">© {currentYear} <span class="text-white font-medium">BluVy</span>. All rights reserved.</p>
        <p class="text-ocean-200/40 text-xs">Xây dựng với 💧 bằng <a href="https://astro.build" class="text-ocean-300 hover:text-white transition-colors" target="_blank" rel="noopener">Astro</a> — Tải trang dưới 2 giây</p>
      </div>
    </div>
  </div>
</footer>
