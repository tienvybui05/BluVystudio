---
interface Props {
  className?: string;
  showText?: boolean;
  theme?: 'light' | 'dark';
}

const { className = "w-10 h-10", showText = true, theme = 'light' } = Astro.props;

const textColorClass = theme === 'light' ? 'text-ocean-950' : 'text-white';
const subTextColorClass = theme === 'light' ? 'text-ocean-600' : 'text-ocean-300';
---

<div class={`flex items-center gap-3 group ${className.includes('w-') ? '' : 'h-10'}`}>
  <!-- BluVy Logo Icon - The Prisma B -->
  <div class={`shrink-0 transition-transform duration-500 group-hover:scale-110 ${className}`}>
    <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full drop-shadow-md">
      <defs>
        <!-- Ocean Blue Gradient -->
        <linearGradient id="bluvy-ocean" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#00D4FF"/>
          <stop offset="100%" stop-color="#0057FF"/>
        </linearGradient>
        <!-- Violet Pink Gradient -->
        <linearGradient id="bluvy-violet" x1="0%" y1="100%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#F472B6"/>
          <stop offset="100%" stop-color="#8B5CF6"/>
        </linearGradient>
        <!-- Soft Glow for 3D effect -->
        <filter id="logo-shadow" x="-20%" y="-20%" width="140%" height="140%">
          <feDropShadow dx="0" dy="6" stdDeviation="6" flood-color="#0057FF" flood-opacity="0.25" />
        </filter>
      </defs>

      <!-- Background Soft Squircle (Provides container balance) -->
      <rect width="100" height="100" rx="28" fill="url(#bluvy-ocean)" fill-opacity="0.08" />
      <rect x="2" y="2" width="96" height="96" rx="26" stroke="url(#bluvy-ocean)" stroke-opacity="0.15" stroke-width="4" />

      <g filter="url(#logo-shadow)">
        <!-- 1. The Pillar (I) -->
        <rect x="20" y="15" width="16" height="70" rx="8" fill="url(#bluvy-ocean)" />

        <!-- 2. The Top Loop (O) -->
        <circle cx="52" cy="36" r="11" fill="none" stroke="url(#bluvy-ocean)" stroke-width="14" />

        <!-- 3. The Bottom Wing (V) -->
        <path d="M 36 54 L 58 78 L 80 54" fill="none" stroke="url(#bluvy-violet)" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" />
      </g>

      <!-- Spark / Star detail (Optional modern tech touch) -->
      <circle cx="80" cy="25" r="4" fill="#A855F7" />
      <circle cx="70" cy="15" r="2.5" fill="#00D4FF" />
    </svg>
  </div>

  {showText && (
    <div class="flex flex-col overflow-hidden">
      <span class={`text-lg md:text-xl font-extrabold ${textColorClass} leading-tight tracking-tight transition-transform duration-300 group-hover:translate-x-1`}>
        Blu<span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-violet-500">Vy</span>
      </span>
      <span class={`text-[10px] ${subTextColorClass} tracking-[0.2em] uppercase -mt-0.5 font-bold transition-transform duration-300 delay-75 group-hover:translate-x-1`}>Web Studio</span>
    </div>
  )}
</div>
