---
export interface Props { formId?: string; }
const { formId = "contact-form" } = Astro.props;
const services = ["Thiết kế Landing Page", "Website Doanh Nghiệp", "Tối ưu PageSpeed", "Web Bán Hàng", "Thiết kế theo yêu cầu"];
---

<form id={formId} class="space-y-5" novalidate>
  <div>
    <label for={`${formId}-name`} class="block text-sm font-medium text-slate-700 mb-2">Họ và tên</label>
    <input type="text" id={`${formId}-name`} name="name" placeholder="Nguyễn Văn A"
      class="w-full px-4 py-3.5 bg-ocean-50/50 border border-ocean-200 rounded-xl text-slate-800 placeholder-slate-400 focus:outline-none focus:border-ocean-400 focus:ring-2 focus:ring-ocean-200 transition-all duration-300" />
  </div>
  <div>
    <label for={`${formId}-phone`} class="block text-sm font-medium text-slate-700 mb-2">Số điện thoại <span class="text-red-500">*</span></label>
    <input type="tel" id={`${formId}-phone`} name="phone" placeholder="0912 345 678" required
      class="w-full px-4 py-3.5 bg-ocean-50/50 border border-ocean-200 rounded-xl text-slate-800 placeholder-slate-400 focus:outline-none focus:border-ocean-400 focus:ring-2 focus:ring-ocean-200 transition-all duration-300" />
  </div>

  <div>
    <label for={`${formId}-message`} class="block text-sm font-medium text-slate-700 mb-2">Lời nhắn</label>
    <textarea id={`${formId}-message`} name="message" rows="4" placeholder="Mô tả ngắn về dự án của bạn..."
      class="w-full px-4 py-3.5 bg-ocean-50/50 border border-ocean-200 rounded-xl text-slate-800 placeholder-slate-400 focus:outline-none focus:border-ocean-400 focus:ring-2 focus:ring-ocean-200 transition-all duration-300 resize-none"></textarea>
  </div>
  <button type="submit" id={`${formId}-submit`} class="btn-primary w-full justify-center !py-4 text-base ripple-effect">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
    <span>Gửi yêu cầu tư vấn</span>
  </button>
  <div id={`${formId}-status`} class="hidden"></div>
</form>

<script is:inline define:vars={{ formId }}>
(function() {
  const form = document.getElementById(formId);
  const statusEl = document.getElementById(`${formId}-status`);
  const submitBtn = document.getElementById(`${formId}-submit`);
  if (!form) return;
  form.addEventListener("submit", async function(e) {
    e.preventDefault();
    const phone = form.querySelector('[name="phone"]').value.trim();
    if (!phone) { showStatus("error", "Vui lòng nhập số điện thoại."); return; }
    if (!/^(0|\+84)[0-9]{9,10}$/.test(phone.replace(/[\s.-]/g, ""))) { showStatus("error", "Số điện thoại không hợp lệ."); return; }
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg><span>Đang gửi...</span>';
    const formData = { 
      name: form.querySelector('[name="name"]').value.trim(), 
      phone, 
      service: "Không xác định", 
      message: form.querySelector('[name="message"]').value.trim(), 
      timestamp: new Date().toISOString() 
    };
    try {
      const r = await fetch("/api/contact", { 
        method: "POST", 
        headers: { "Content-Type": "application/json", "Accept": "application/json" }, 
        body: JSON.stringify(formData) 
      });
      const data = await r.json();
      if (r.ok) { 
        showStatus("success", "🎉 Gửi thành công! Chúng tôi sẽ liên hệ trong 30 phút."); 
        form.reset(); 
      } else { 
        throw new Error(data.message || "Lỗi không xác định"); 
      }
    } catch (err) { 
      showStatus("error", err.message || "Có lỗi xảy ra. Vui lòng gọi hotline 0362.567.759."); 
    }
    finally { submitBtn.disabled = false; submitBtn.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg><span>Gửi yêu cầu tư vấn</span>'; }
  });
  function showStatus(type, msg) {
    statusEl.className = `mt-4 p-4 rounded-xl text-sm font-medium ${type === "success" ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-red-50 text-red-700 border border-red-200"}`;
    statusEl.textContent = msg; statusEl.style.display = "block";
    setTimeout(() => { statusEl.style.display = "none"; }, 8000);
  }
})();
</script>
