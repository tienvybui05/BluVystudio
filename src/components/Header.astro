---
const navLinks = [
  { href: "/", label: "Trang chủ" },
  { href: "/gioi-thieu", label: "Giới thiệu" },
  { href: "/dich-vu", label: "Dịch vụ" },
  { href: "/bang-gia", label: "Bảng giá" },
  { href: "/blog", label: "Blog" },
  { href: "/lien-he", label: "Liên hệ" },
];
const currentPath = Astro.url.pathname;
---

<!-- Fixed Outer Wrapper -->
<div class="fixed top-0 left-0 right-0 z-50 px-3 sm:px-6 pt-3 pointer-events-none" id="main-header-wrapper">
  <header class="max-w-6xl mx-auto rounded-full floating-glass-header pointer-events-auto px-4 sm:px-6 py-2 transition-all duration-300" id="main-header">
    <div class="flex items-center justify-between h-12 md:h-14">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group" aria-label="BluVy - Trang chủ">
        <!-- BluVy Logo Icon -->
        <div class="w-9 h-9 md:w-10 md:h-10 shrink-0 transition-transform group-hover:scale-110">
          <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
            <defs>
              <linearGradient id="hdr-b-grad" x1="0" y1="0" x2="40" y2="40" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#00D4FF"/>
                <stop offset="100%" stop-color="#0066FF"/>
              </linearGradient>
            </defs>
            <rect width="40" height="40" rx="12" fill="url(#hdr-b-grad)"/>
            <!-- Stylized B mark -->
            <path d="M12 10h10c3.5 0 6 2 6 5.5 0 1.5-.6 2.8-1.6 3.7C28.3 20.3 29 22 29 24c0 3.5-2.5 6-7 6H12V10z" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M12 20h9" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-base font-extrabold text-ocean-950 leading-tight tracking-tight">Blu<span class="text-transparent bg-clip-text bg-gradient-to-r from-[#0066FF] to-[#8B5CF6]">Vy</span></span>
          <span class="text-[9px] text-ocean-600 tracking-[0.18em] uppercase -mt-0.5 font-bold">Web Studio</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-1.5" aria-label="Menu chính">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class:list={[
                "px-4 py-1.5 rounded-full text-xs md:text-sm font-bold transition-all duration-300 relative",
                isActive
                  ? "gradient-ocean text-white shadow-md shadow-ocean-400/30 scale-105"
                  : "text-slate-700 hover:text-ocean-800 hover:bg-ocean-50/80",
              ]}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Right CTA -->
      <div class="hidden lg:flex items-center gap-3">
        <a href="tel:0362567759" class="flex items-center gap-2 text-slate-600 hover:text-ocean-700 transition-colors mr-2 group/phone">
          <div class="w-8 h-8 rounded-full bg-ocean-50 border border-ocean-100 flex items-center justify-center group-hover/phone:bg-ocean-100 transition-colors">
            <svg class="w-4 h-4 text-ocean-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          </div>
          <span class="font-bold text-sm">0362.567.759</span>
        </a>
        <a href="/lien-he" class="btn-primary !py-2 !px-5 !text-xs md:!text-sm !rounded-full !shadow-lg whitespace-nowrap">
          ✦ Báo Giá Miễn Phí
        </a>
      </div>

      <!-- Mobile Toggle Button -->
      <div id="mobile-menu-btn" class="lg:hidden flex flex-col gap-1.5 cursor-pointer p-2 z-50 pointer-events-auto" aria-label="Mở menu">
        <span class="w-6 h-0.5 bg-ocean-700 rounded-full transition-all duration-300"></span>
        <span class="w-6 h-0.5 bg-ocean-700 rounded-full transition-all duration-300"></span>
        <span class="w-4 h-0.5 bg-ocean-700 rounded-full transition-all duration-300"></span>
      </div>
    </div>
  </header>
</div>

<!-- Mobile Menu Overlay & Drawer -->
<div id="mobile-menu-overlay" class="fixed inset-0 bg-ocean-950/40 backdrop-blur-sm z-40 opacity-0 pointer-events-none transition-opacity duration-300"></div>
<nav id="mobile-nav-menu" class="fixed top-0 right-0 w-80 max-w-[85vw] h-screen bg-white/98 backdrop-blur-2xl border-l border-ocean-100 p-8 pt-24 transform translate-x-full transition-transform duration-300 ease-in-out z-50 lg:hidden overflow-y-auto shadow-2xl" aria-label="Menu di động">
  <div class="flex flex-col gap-2">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class:list={[
          "px-4 py-3 rounded-2xl text-base font-semibold transition-all duration-300",
          currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href))
            ? "gradient-ocean text-white font-bold shadow-md shadow-ocean-300/30"
            : "text-slate-700 hover:text-ocean-700 hover:bg-ocean-50",
        ]}
      >
        {link.label}
      </a>
    ))}
    <a href="/lien-he" class="btn-primary mt-4 justify-center !rounded-full">✦ Báo Giá Miễn Phí</a>
  </div>
  <div class="mt-8 pt-6 relative">
    <div class="h-[1px] bg-gradient-to-r from-transparent via-ocean-200/50 to-transparent mb-6"></div>
    <a href="tel:0362567759" class="flex items-center gap-3 text-slate-500 hover:text-ocean-600 transition-colors py-2">
      <svg class="w-5 h-5 text-ocean-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
      <span class="text-sm font-medium">0362.567.759</span>
    </a>
    <a href="mailto:support@bluvy.io.vn" class="flex items-center gap-3 text-slate-500 hover:text-ocean-600 transition-colors py-2">
      <svg class="w-5 h-5 text-ocean-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      <span class="text-sm font-medium">support@bluvy.io.vn</span>
    </a>
  </div>
</nav>

<script is:inline>
  (function() {
    // Scroll Header Logic
    function onHeaderScroll() {
      const header = document.getElementById("main-header");
      if (!header) return;
      if (window.scrollY > 20) {
        header.classList.add("scrolled");
      } else {
        header.classList.remove("scrolled");
      }
    }
    window.addEventListener("scroll", onHeaderScroll, { passive: true });
    onHeaderScroll();

    // Mobile Menu Toggle Logic
    const toggleBtn = document.getElementById("mobile-menu-btn");
    const overlay = document.getElementById("mobile-menu-overlay");
    const navMenu = document.getElementById("mobile-nav-menu");
    const spans = toggleBtn ? toggleBtn.querySelectorAll("span") : [];

    let isMenuOpen = false;

    function toggleMenu() {
      isMenuOpen = !isMenuOpen;
      if (isMenuOpen) {
        overlay.classList.remove("opacity-0", "pointer-events-none");
        navMenu.classList.remove("translate-x-full");
        // Animate hamburger to X
        if(spans.length === 3) {
          spans[0].style.transform = "translateY(8px) rotate(45deg)";
          spans[1].style.opacity = "0";
          spans[2].style.transform = "translateY(-8px) rotate(-45deg)";
          spans[2].style.width = "24px";
        }
      } else {
        overlay.classList.add("opacity-0", "pointer-events-none");
        navMenu.classList.add("translate-x-full");
        // Revert hamburger
        if(spans.length === 3) {
          spans[0].style.transform = "none";
          spans[1].style.opacity = "1";
          spans[2].style.transform = "none";
          spans[2].style.width = "16px"; // w-4 is 1rem=16px
        }
      }
    }

    if (toggleBtn) {
      toggleBtn.addEventListener("click", toggleMenu);
    }
    if (overlay) {
      overlay.addEventListener("click", toggleMenu);
    }
  })();
</script>

<style is:global>
  .z-45 { z-index: 45; }
</style>
